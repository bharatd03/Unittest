{
  "brain": {
    "engine": {"mode": "auto", "brain_order": ["opus", "fable", "sonnet", "haiku", "qwen_remote", "qwen"],
               "runaway_factor": 1.5, "answer_list_max": 40, "answer_text_max": 8000},
    "qwen_remote": {"base_url": "https://llm.openroute-ai.com/v1", "model": "qwen3-8b", "api_key_env": "QWEN_REMOTE_API_KEY",
                    "max_concurrency": 2, "stream": true, "stream_idle": 90, "shared_slots": true,
                    "gateway_retries": 3, "gateway_pause": 15, "slot_wait": 1800,
                    "think_steps": ["A3.repair", "A1.declaration"],
                    "generate_temperature": 0.7, "top_p": 0.8, "top_k": 20, "think_temperature": 0.6, "think_top_p": 0.95},
    "qwen": {"model": "qwen3:8b", "adaptive": true, "windows": [4096, 8192, 12288, 16384], "max_num_predict": 8192,
             "generate_num_ctx": 16384, "generate_num_predict": 4096, "generate_timeout": 900, "max_concurrency": 1,
             "think_steps": ["A3.repair", "A1.declaration"],
             "generate_temperature": 0.7, "top_p": 0.8, "top_k": 20, "think_temperature": 0.6, "think_top_p": 0.95},
    "anthropic": {"models": {"opus": "claude-opus-5-5", "fable": "claude-fable-5-1", "sonnet": "claude-sonnet-5-5",
                             "haiku": "claude-haiku-5-5"},
                  "effort": "high", "max_tokens": 16000, "adaptive": true, "thinking_reserve": 8000,
                  "parallel_calls": 4, "rate_limit_wait": 300}
  },
  "profiles": {
    "_comment": "BP-1, BP-2, BP-6, BP-8: what each brain may write. Answer kinds: values, scenario, call_sequence, setup, stub, test, suite_part, repair, decision, file_edit (a free edit of generated files after the offered repairs failed, BP-11; without it a brain only chooses among the repairs the rules offer). A brain without an entry gets minimum.",
    "brains": {"opus": "full", "fable": "full", "sonnet": "full", "haiku": "full", "qwen_remote": "minimum", "qwen": "minimum"},
    "definitions": {
      "minimum": {"kinds": ["values", "scenario", "call_sequence", "repair", "decision", "file_edit"], "journal_tokens": 1500,
                  "long_function_lines": 150, "window_tokens": 16384, "scenarios_per_call": 4},
      "full": {"kinds": ["values", "scenario", "call_sequence", "setup", "stub", "test", "suite_part", "repair", "decision", "file_edit"],
               "journal_tokens": 8000, "long_function_lines": 0, "window_tokens": 1000000, "scenarios_per_call": 4}
    },
    "steps": {},
    "calibration_share": 0.9
  },
  "coverage": {
    "default_level": "D",
    "files": {},
    "levels": {
      "QM": {"LC": "100", "SC": "100", "BC": "100", "DC": "100", "MCDC": ">95"},
      "A":  {"LC": "100", "SC": "100", "BC": "100", "DC": "100", "MCDC": ">95"},
      "B":  {"LC": "100", "SC": "100", "BC": "100", "DC": "100", "MCDC": ">95"},
      "C":  {"LC": "100", "SC": "100", "BC": "100", "DC": "100", "MCDC": "100"},
      "D":  {"LC": "100", "SC": "100", "BC": "100", "DC": "100", "MCDC": "100"}
    },
    "iterations": {"QM": 10, "A": 10, "B": 10, "C": 10, "D": 10}
  },
  "viewer": {"enabled": true, "open_browser": true, "host": "127.0.0.1", "port": 0, "replay": true,
             "token_env": "", "metrics": []},
  "pipeline": {
    "stagnation_limit": 2,
    "stage_a_rounds": 3,
    "call_timeout": 3600,
    "output_dir": "ut_output",
    "deliver_tests_to_repo": true,
    "fuzz_after_stagnation": true,
    "fuzz_budget_seconds": 300,
    "after_target_seconds": 600,
    "attempts_per_item": 2,
    "minutes_per_function": 2,
    "min_minutes_per_file": 10,
    "journal_tokens": 1500,
    "lesson_rule_count": 3,
    "trials_per_iteration": 10,
    "recipe_candidate_uses": 3,
    "compile_gate": true,
    "gate_rewrites": 1,
    "unbuilt_rounds": 2,
    "rate_target": 5,
    "interactive": false,
    "interactive_wait_seconds": 600,
    "repo_cache": "ut_cache",
    "max_parallel_suts": 2,
    "git_token_env": "",
    "git_token_user": "x-access-token",
    "git_author": "ut-pipeline <ut-pipeline@localhost>",
    "repositories": {},
    "keep_worktrees": false,
    "agents": {
      "analyzer": {"transport": "stdio"},
      "generator": {"transport": "stdio"},
      "compilation": {"transport": "stdio"},
      "corrector": {"transport": "stdio"},
      "kb": {"transport": "stdio"}
    }
  },
  "analyzer": {"max_attempts_per_gap": 2, "long_function_lines": 150, "max_scenarios_per_function": 12, "real_dependency_depth": 2,
               "requirement_files": [], "max_brain_calls_per_function": 2,
               "brain_functions_per_round": 30, "state_per_function": 40,
               "max_lookups_per_function": 6, "link_requirements": true, "propose_declarations": true,
               "rule_attempts": 2, "prefer_project_stubs": false,
               "targets_per_scenario": 3, "split_calls": 3, "carry_families": true},
  "generator": {"mode": "deterministic_then_llm", "max_auto_tests_per_function": 24, "max_llm_tests_per_function": 8,
                "rule_attempts": 2, "max_brain_values": 12},
  "compilation": {
    "tools_manifest": "tools/toolchain.json",
    "parallel_runs": 4,
    "required_metrics": ["LC", "SC", "BC", "DC", "MCDC"],
    "work_dir": "ut_work",
    "max_mutants": 50,
    "fault_check_seconds": 120,
    "fault_check_workers": 0,
    "mutant_run_timeout": 5,
    "compile_timeout": 120,
    "run_timeout": 60,
    "build_timeout": 1800,
    "fuzz_seconds": 60,
    "flag_rounds": 2,
    "quarantine_rounds": 4,
    "repair_rounds": 2,
    "rule_attempts": 2,
    "search_restarts": 20,
    "split_suite_tests": 200,
    "test_time_limit_ms": 2000,
    "target_data_model": "",
    "build_commands": {}
  },
  "corrector": {"max_fragment_lines": 30, "min_independent_evidence": 2, "candidates": 3, "suggestions": 3},
  "kb": {"db_path": "ut_kb.sqlite3", "resolutions_path": "ut_resolutions.sqlite3",
         "_comment": "KB-23..KB-25: verified tests and scenarios of the brain as examples per function; UT_KNOWLEDGE=off or examples false switches them off",
         "examples": true, "examples_per_function": 2, "max_examples": 3000},
  "cache": {"_comment": "CA-1: caches of earlier work - they save time, never decide a result; run --no-cache or UT_CACHE=off to switch them off",
            "enabled": true, "dir": "ut_cache/run_cache", "max_mb": 4096, "brain_answers": true, "test_coverage": true,
            "verified_tests": true, "objects": true, "build_capture": true, "failure_journal": true,
            "failure_analysis": true, "stage_a": true, "code_analysis": true, "mutations": true, "search_corpus": true},
  "requirements": {"_comment": "A1-RQ1: requirement documents per repository - {\"repository link or folder\": [\"file or folder\", ...]}; relative paths: inside the repository"},
  "knowledge": {"enabled": true, "dirs": ["knowledge"], "project_dir": ".ut/knowledge"},
